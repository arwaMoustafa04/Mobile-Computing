<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:padding="@dimen/spacing_lg">

    <ImageView
        android:id="@+id/songImage"
        android:layout_width="@dimen/song_image_size"
        android:layout_height="@dimen/song_image_size"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="@dimen/spacing_lg">

        <TextView
            android:id="@+id/songTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/text_xl"
            android:textStyle="bold"
            android:textColor="@color/white"/>

        <TextView
            android:id="@+id/songArtist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:textSize="@dimen/text_md" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/btnAddSong"
        android:layout_width="@dimen/btn_icon_lg"
        android:layout_height="@dimen/btn_icon_lg"
        android:src="@drawable/add_better"
        android:background="@null"
        android:scaleType="centerInside"
        android:padding="@dimen/spacing_sm"/>
</LinearLayout>
