<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/black">

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/fragment_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:id="@+id/miniPlayer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/dark_surface"
        android:padding="@dimen/spacing_md"
        android:gravity="center_vertical"
        android:visibility="gone">

        <ImageView
            android:id="@+id/miniAlbumArt"
            android:layout_width="@dimen/mini_album_art_size"
            android:layout_height="@dimen/mini_album_art_size"
            android:scaleType="centerCrop"
            android:src="@drawable/placeholder_image" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="@dimen/spacing_lg">

            <TextView
                android:id="@+id/miniSongTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_song_title_placeholder"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/miniArtistName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_artist_placeholder"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_xs" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnPrev"
            android:layout_width="@dimen/btn_icon_lg"
            android:layout_height="@dimen/btn_icon_lg"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_media_previous"
            android:contentDescription="@string/cd_previous" />

        <ImageButton
            android:id="@+id/btnPlayPause"
            android:layout_width="@dimen/btn_icon_xl"
            android:layout_height="@dimen/btn_icon_xl"
            android:padding="@dimen/spacing_lg"
            android:scaleType="fitCenter"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_media_play" />

        <ImageButton
            android:id="@+id/btnNext"
            android:layout_width="@dimen/btn_icon_lg"
            android:layout_height="@dimen/btn_icon_lg"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_media_next"
            android:contentDescription="@string/cd_next" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/bottomNav"
        android:fitsSystemWindows="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/spacing_lg">

        <ImageButton
            android:id="@+id/profileBtn"
            android:layout_width="0dp"
            android:layout_height="@dimen/btn_icon_size"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:scaleType="centerInside"
            android:src="@drawable/profile" />

        <ImageButton
            android:id="@+id/searchBtn"
            android:layout_width="0dp"
            android:layout_height="@dimen/btn_icon_size"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:scaleType="centerInside"
            android:src="@drawable/search" />

        <ImageButton
            android:id="@+id/libraryBtn"
            android:layout_width="0dp"
            android:layout_height="@dimen/btn_icon_size"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:scaleType="centerInside"
            android:src="@drawable/library" />

        <ImageButton
            android:id="@+id/aiBtn"
            android:layout_width="0dp"
            android:layout_height="@dimen/btn_icon_size"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:scaleType="centerInside"
            android:src="@drawable/ic_auto_awesome"
            android:contentDescription="AI Playlist" />
    </LinearLayout>
</LinearLayout>
