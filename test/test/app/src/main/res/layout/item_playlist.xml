<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="80dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="@dimen/spacing_lg"
    android:paddingEnd="@dimen/spacing_md"
    android:paddingTop="@dimen/spacing_sm"
    android:paddingBottom="@dimen/spacing_sm"
    android:background="?attr/selectableItemBackground">

    <ImageView
        android:id="@+id/imgPlaylistCover"
        android:layout_width="@dimen/playlist_cover_size"
        android:layout_height="@dimen/playlist_cover_size"
        android:scaleType="centerCrop"
        android:src="@drawable/placeholder_image"
        android:background="@color/darker_gray" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="@dimen/spacing_xl"
        android:paddingEnd="@dimen/spacing_md">

        <TextView
            android:id="@+id/tvPlaylistName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_playlist_name"
            android:textColor="@color/white"
            android:textSize="@dimen/text_lg"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tvSongCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_by_you"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_sm"
            android:layout_marginTop="@dimen/spacing_xs" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/btnPlaylistMore"
        android:layout_width="@dimen/btn_icon_lg"
        android:layout_height="@dimen/btn_icon_lg"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/more"
        android:scaleType="centerInside"
        android:contentDescription="@string/cd_more_options" />

</LinearLayout>
